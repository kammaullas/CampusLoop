{
  "name": "campusloop",
  "version": "1.0.0",
  "description": "CampusLoop — Campus growth and referral attribution system for NxtWave workshop campaigns",
  "private": true,
  "scripts": {
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install:all": "npm install && cd client && npm install",
    "build": "cd client && npm run build",
    "seed": "node server/seed.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "nanoid": "^3.3.7",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
